<mxCell id="title2" value="AYNI  |  Flujos: publicar en 3 toques, modo offline, Modo Minka (emergencia) y recomendaciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="50" as="geometry"/></mxCell>
<mxCell id="a0" value="Vecino abre Ayni&lt;br&gt;(ve el mapa de su barrio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="a1" value="TOQUE 1&lt;br&gt;botón (+)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="150" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="a2" value="TOQUE 2&lt;br&gt;elige tipo:&lt;br&gt;Ofrezco / Necesito / Recomiendo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="150" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="a3" value="TOQUE 3&lt;br&gt;foto o nota de voz&lt;br&gt;+ botón Publicar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="150" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="a4" value="Ubicación automática&lt;br&gt;(GPS -&gt; celda aprox.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="150" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="a5" value="¿Hay internet?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="150" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="a6" value="SÍ: Gemini clasifica&lt;br&gt;categoría + transcribe voz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="110" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="a7" value="NO: clasificador local&lt;br&gt;(palabras clave) + cola IndexedDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="210" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="a8" value="Guarda en Firestore&lt;br&gt;(estado: activa)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1620" y="110" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="a9" value="Guarda local&lt;br&gt;(estado: enCola)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1620" y="210" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="a10" value="Resultado: la publicación aparece en el mapa de los vecinos del radio caminable con la etiqueta de categoría. Tiempo objetivo: menos de 20 segundos desde abrir la app." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="1770" height="60" as="geometry"/></mxCell>
<mxCell id="b1" value="Se va la señal&lt;br&gt;(service worker lo detecta)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="510" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="b2" value="App sigue abriendo:&lt;br&gt;caché de pantallas + tiles&lt;br&gt;vistos del barrio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="510" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="b3" value="Publicaciones nuevas&lt;br&gt;se guardan en cola&lt;br&gt;con marca &quot;pendiente&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="510" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="b4" value="Vuelve la señal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="640" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="b5" value="Sincronizador envía la cola&lt;br&gt;a Firestore (orden FIFO,&lt;br&gt;reintento si falla)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="640" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="b6" value="Gemini clasifica lo&lt;br&gt;pendiente; mapa se&lt;br&gt;actualiza en tiempo real" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="640" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="b7" value="Demo: activar&lt;br&gt;modo avión en vivo,&lt;br&gt;publicar, reactivar&lt;br&gt;y ver que sube" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="560" width="160" height="110" as="geometry"/></mxCell>
<mxCell id="d1" value="Vecino busca &quot;gasfitero&quot;&lt;br&gt;o toca un marcador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="500" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="d2" value="Ve: &quot;Recomendado por 12&lt;br&gt;vecinos de tu zona&quot; + resumen IA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230" y="500" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="d3" value="BOTÓN WHATSAPP&lt;br&gt;abre wa.me/51... con&lt;br&gt;mensaje precargado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="500" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="d3b" value="Emprendimiento gana&lt;br&gt;un cliente nuevo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1670" y="500" width="170" height="60" as="geometry"/></mxCell>
<mxCell id="d4" value="Después de ayudar: quien&lt;br&gt;recibió la ayuda la confirma&lt;br&gt;(+10 puntos Ayni)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="590" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="d5" value="Catálogo de recompensas&lt;br&gt;ofrecidas por negocios&lt;br&gt;(&quot;10% dcto&quot;, &quot;1 pan gratis&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230" y="590" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="d6" value="Canjea: código de 6&lt;br&gt;dígitos; el negocio&lt;br&gt;lo valida en su app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1460" y="590" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="d6b" value="Negocio gana insignia&lt;br&gt;&quot;Solidario&quot; + destacado&lt;br&gt;en el mapa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1670" y="590" width="170" height="60" as="geometry"/></mxCell>
<mxCell id="d7" value="Puntos: ayuda confirmada = 10 | recomendación verificada = 2 | ayudar en Minka = 20 | negocio que dona en emergencia = 30.&lt;br&gt;El negocio no paga dinero: pone la recompensa con su propio producto a cambio de visibilidad&lt;br&gt;y clientes nuevos. Los puntos vencen a los 6 meses para que circulen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="680" width="830" height="80" as="geometry"/></mxCell>
<mxCell id="c1" value="Disparador:&lt;br&gt;- alerta de autoridad&lt;br&gt;- o &gt;= 3 vecinos verificados&lt;br&gt;  reportan de distintas celdas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="870" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="c2" value="Toda la interfaz cambia:&lt;br&gt;3 botones grandes&lt;br&gt;(funciona offline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="870" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="c3a" value="ESTOY BIEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="840" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="c3b" value="NECESITO AYUDA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="905" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="c3c" value="PUEDO AYUDAR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="970" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="c4a" value="Marca al vecino como a salvo&lt;br&gt;(sus contactos lo ven)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="840" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="c4b" value="Elige tipo: agua / medicina /&lt;br&gt;albergue / rescate + urgencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="905" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="c4c" value="Elige recurso: enfermera /&lt;br&gt;botiquín / generador / espacio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="970" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="c5" value="Mapa Minka:&lt;br&gt;necesidades (rojo) vs&lt;br&gt;recursos (verde), puntos&lt;br&gt;de acopio y brigadas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="870" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="c6" value="Match automático:&lt;br&gt;recurso más cercano del&lt;br&gt;mismo tipo según urgencia&lt;br&gt;(ej. enfermera a 2 cuadras)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1280" y="870" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="c7" value="Notifica a ambos vecinos&lt;br&gt;+ chat/WhatsApp para coordinar.&lt;br&gt;Necesidad pasa a &quot;atendida&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1540" y="870" width="290" height="80" as="geometry"/></mxCell>
<mxCell id="c9" value="NOTICIAS LOCALES (Boletín Minka)&lt;br&gt;Demo: colección avisos_minka alimentada por&lt;br&gt;moderador (municipio / El Comercio) + parte de zona&lt;br&gt;que Gemini resume cada hora con reportes vecinales.&lt;br&gt;Escalabilidad: ingestión automática de IGP, Senamhi,&lt;br&gt;Indeci y El Comercio como socio de contenido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1400" y="1060" width="430" height="120" as="geometry"/></mxCell>
<mxCell id="c8" value="Coordinación: los vecinos &quot;Puedo ayudar&quot; forman brigadas por cuadra; los puntos de acopio se marcan en el mapa;&lt;br&gt;el resumen IA muestra a la municipalidad / serenazgo qué falta por zona (ej. &quot;Cuadra 5: 3 familias sin agua, 1 herido leve&quot;).&lt;br&gt;Al terminar la emergencia la app vuelve al Modo Barrio y los que ayudaron reciben puntos Ayni.&lt;br&gt;Valor para El Comercio: canal hiperlocal de información verificada durante la emergencia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="1060" width="1300" height="120" as="geometry"/></mxCell>
<mxCell id="e1" value="Abre Ayni por&lt;br&gt;primera vez -&gt;&lt;br&gt;tutorial (3 pantallas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="1290" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="e2" value="Teléfono + código SMS&lt;br&gt;(Firebase Auth)&lt;br&gt;1 cuenta por número" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="270" y="1290" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="e3" value="Ingresa DNI (8 dígitos)&lt;br&gt;+ acepta consentimiento&lt;br&gt;de verificación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="1290" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="e4" value="Mini servidor Node&lt;br&gt;(guarda API key) llama a&lt;br&gt;Didit -&gt; RENIEC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="1290" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="e5" value="¿Coincide?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="1290" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="e6" value="SÍ: cuenta creada, DNI guardado&lt;br&gt;como hash (1 cuenta por DNI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="1255" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="e7" value="NO / sin respuesta: cuenta&lt;br&gt;&quot;pendiente de verificación&quot;&lt;br&gt;(puede ver, no gana puntos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="1330" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="e8" value="2 vecinos verificados&lt;br&gt;lo avalan (botón &quot;Lo&lt;br&gt;conozco&quot; en su perfil)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="1290" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="e9" value="VECINO VERIFICADO&lt;br&gt;puede recomendar, ganar&lt;br&gt;puntos y activar Minka" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1610" y="1290" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="foot2" value="Criterios del jurado cubiertos:  Usabilidad (3 toques, tutorial)  |  Confiabilidad (offline + clasificador de respaldo)  |  Escalabilidad (Firestore, colecciones separadas)  |  Innovación (IA + Modo Minka + puntos Ayni)  |  Propuesta (valor para municipios y El Comercio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="1820" height="50" as="geometry"/></mxCell>
