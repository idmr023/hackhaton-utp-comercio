<mxCell id="vecino" value="Vecino&lt;br&gt;(Android / iPhone, navegador)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="tutorial" value="Tutorial de 3 pantallas&lt;br&gt;(solo la primera vez)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="140" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="modo_barrio" value="MODO BARRIO (Ayni)&lt;br&gt;- Mapa radio caminable&lt;br&gt;- Ofrezco / Necesito / Recomiendo&lt;br&gt;- Trueque y puntos Ayni" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="250" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="modo_minka" value="MODO MINKA (emergencia)&lt;br&gt;- 3 botones grandes&lt;br&gt;- Mapa necesidades vs recursos&lt;br&gt;- Acopio y brigadas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="250" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="access" value="Accesibilidad: notas de voz, idioma quechua, letra grande,&lt;br&gt;contraste alto, publicar en máximo 3 toques" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="380" width="460" height="80" as="geometry"/></mxCell>
<mxCell id="ui" value="Pantallas React&lt;br&gt;(Mapa, Publicar, Perfil,&lt;br&gt;Minka)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="140" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="leaflet" value="Leaflet + OpenStreetMap&lt;br&gt;radio 1 km (~15 min a pie)&lt;br&gt;ampliable a 2 / 5 km" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="140" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="geo" value="Geolocalización&lt;br&gt;(navigator.geolocation)&lt;br&gt;ubicación automática" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="sw" value="Service Worker&lt;br&gt;(Workbox)&lt;br&gt;- cachea app y tiles&lt;br&gt;- detecta online/offline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="250" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="idb" value="Almacén local&lt;br&gt;(IndexedDB)&lt;br&gt;- cola de publicaciones&lt;br&gt;- último estado del mapa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="250" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="sync" value="Sincronizador&lt;br&gt;- envía la cola al volver&lt;br&gt;  la señal&lt;br&gt;- reintentos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="250" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="clasif_local" value="Clasificador de respaldo (reglas por palabras clave)&lt;br&gt;&quot;gasfitero&quot; -&gt; Oficios, &quot;agua&quot; -&gt; Necesidad básica. Se usa si la IA falla o no hay internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="380" width="580" height="80" as="geometry"/></mxCell>
<mxCell id="auth" value="Firebase Auth&lt;br&gt;(teléfono o Google)&lt;br&gt;identidad del vecino" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="140" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="firestore" value="Cloud Firestore&lt;br&gt;(persistencia offline activada)&lt;br&gt;base de datos en tiempo real" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1590" y="140" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="gemini" value="Gemini API (nivel gratuito)&lt;br&gt;- clasifica la publicación&lt;br&gt;- resume recomendaciones&lt;br&gt;- transcribe nota de voz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="250" width="250" height="90" as="geometry"/></mxCell>
<mxCell id="osm" value="Servidores de tiles&lt;br&gt;OpenStreetMap (gratis, sin API key)&lt;br&gt;El service worker cachea&lt;br&gt;los tiles ya vistos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1590" y="250" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="rules" value="Reglas de seguridad Firestore:&lt;br&gt;solo el autor edita lo suyo;&lt;br&gt;ubicación exacta nunca se expone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="380" width="250" height="80" as="geometry"/></mxCell>
<mxCell id="didit" value="Mini servidor Node/Express (local)&lt;br&gt;guarda la API key y llama a&lt;br&gt;Didit API -&gt; RENIEC (valida DNI)&lt;br&gt;500 gratis/mes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1590" y="380" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="d_user" value="usuarios&lt;br&gt;- id, nombre, teléfono&lt;br&gt;- whatsappVisible: bool (opt-in)&lt;br&gt;- zonaAprox (celda ~300 m, no coord. exacta)&lt;br&gt;- verificado: bool, avales: [ids]&lt;br&gt;- puntosAyni: número, idioma" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="580" width="260" height="130" as="geometry"/></mxCell>
<mxCell id="d_pub" value="publicaciones&lt;br&gt;- tipo: OFREZCO | NECESITO | RECOMIENDO&lt;br&gt;- categoría (IA): oficio / producto / alimento...&lt;br&gt;- texto, fotoBase64, audioTexto&lt;br&gt;- geo (aprox), autorId, fecha&lt;br&gt;- estado: activa | resuelta | enCola" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="580" width="270" height="130" as="geometry"/></mxCell>
<mxCell id="d_rec" value="recomendaciones&lt;br&gt;- negocioId / oficioId&lt;br&gt;- autorId, zonaAutor&lt;br&gt;- comentario, fecha&lt;br&gt;=&gt; contador &quot;recomendado por N&lt;br&gt;   vecinos de tu zona&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="580" width="270" height="130" as="geometry"/></mxCell>
<mxCell id="d_neg" value="negocios_oficios&lt;br&gt;- nombre, rubro, geo (aprox)&lt;br&gt;- horario, whatsapp (botón wa.me)&lt;br&gt;- nRecomendaciones, resumenIA&lt;br&gt;- insignias: Recomendado / Solidario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="580" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="d_inter" value="ayudas / intercambios&lt;br&gt;- tipo: AYUDA | TRUEQUE | PRÉSTAMO&lt;br&gt;- ayudaId, recibeId, horas&lt;br&gt;- confirmadoPorReceptor: bool&lt;br&gt;=&gt; al confirmar, suma puntosAyni" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="740" width="260" height="130" as="geometry"/></mxCell>
<mxCell id="d_emer" value="emergencias&lt;br&gt;- activa: bool, tipo (sismo, incendio...)&lt;br&gt;- inicio, fin, zona&lt;br&gt;- origen: autoridad | vecinos (&gt;= 3 reportes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="740" width="270" height="130" as="geometry"/></mxCell>
<mxCell id="d_need" value="necesidades (Minka)&lt;br&gt;- emergenciaId, autorId&lt;br&gt;- tipo: agua | medicina | albergue |&lt;br&gt;  rescate | comida&lt;br&gt;- urgencia 1-3, geo, estado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="740" width="270" height="130" as="geometry"/></mxCell>
<mxCell id="d_res" value="recursos (Minka)&lt;br&gt;- emergenciaId, autorId&lt;br&gt;- tipo: enfermera | botiquín |&lt;br&gt;  generador | vehículo | espacio&lt;br&gt;- disponible, geo, asignadoA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="740" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="d_recomp" value="recompensas (las ofrece el negocio)&lt;br&gt;- negocioId, título (&quot;10% dcto&quot;, &quot;1 pan gratis&quot;)&lt;br&gt;- costoPuntos, stock, vigencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="900" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="d_canje" value="canjes&lt;br&gt;- usuarioId, recompensaId, código 6 dígitos&lt;br&gt;- estado: pendiente | canjeado | vencido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="900" width="270" height="60" as="geometry"/></mxCell>
<mxCell id="d_match" value="Match necesidad &lt;-&gt; recurso&lt;br&gt;más cercano (distancia + urgencia)&lt;br&gt;=&gt; necesidades.asignadoA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="900" width="270" height="60" as="geometry"/></mxCell>
<mxCell id="d_aviso" value="avisos_minka (noticias locales)&lt;br&gt;- emergenciaId, autorRol: moderador&lt;br&gt;- texto, zona, fecha, resumenIA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="900" width="250" height="60" as="geometry"/></mxCell>
<mxCell id="t1" value="1. Registro: teléfono (SMS) + DNI validado en RENIEC vía Didit (hash, con consentimiento)&lt;br&gt;=&gt; 1 cuenta por DNI y por teléfono. Si Didit falla: &quot;pendiente de verificación&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="575" width="520" height="60" as="geometry"/></mxCell>
<mxCell id="t2" value="2. Vecino verificado: 2 vecinos ya verificados lo avalan.&lt;br&gt;Puntos de los primeros 7 días quedan pendientes hasta tener avales" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="650" width="520" height="55" as="geometry"/></mxCell>
<mxCell id="t3" value="3. Solo verificados recomiendan y activan emergencia por reportes.&lt;br&gt;3 reportes ocultan una publicación; alerta vecinal requiere &gt;= 3 celdas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="720" width="520" height="55" as="geometry"/></mxCell>
<mxCell id="t4" value="4. Límite de ayudas (antifraude):&lt;br&gt;- misma pareja A-&gt;B: 10, 5, 0 puntos en el mes&lt;br&gt;- máx. 3 ayudas y 30 puntos por día; 1 canje por negocio por semana&lt;br&gt;- confirmación presencial: código de 4 dígitos + ambos a &lt; 200 m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="790" width="520" height="75" as="geometry"/></mxCell>
<mxCell id="t5" value="5. Escalabilidad: detección de clústeres de cuentas que solo se ayudan&lt;br&gt;entre sí; Didit pasa a $0.20 por consulta sobre las 500 mensuales" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="880" width="520" height="60" as="geometry"/></mxCell>
<mxCell id="foot" value="Costo de la demo: S/ 0  -&gt;  Firebase plan Spark (sin tarjeta), Gemini nivel gratuito, OpenStreetMap, app corriendo en localhost o Firebase Hosting gratis.&lt;br&gt;Leyenda:  azul = usuario   verde = frontend PWA   amarillo = nube Firebase   morado = IA   rojo = emergencia   naranja = datos   gris-azul = confianza" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1820" height="60" as="geometry"/></mxCell>
