# ---- Firebase (P4 lo crea en console.firebase.google.com, plan Spark, SIN tarjeta)
# Si estas variables estan vacias, la app corre en MODO DEMO LOCAL (datos en el navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---- Gemini (aistudio.google.com -> Get API key). Vacio = clasificador por palabras clave.
VITE_GEMINI_API_KEY=

# ---- Didit (solo la usa el servidor Node, NUNCA el frontend). Vacio = respaldo "pendiente".
DIDIT_API_KEY=
