rules_version = '2';
// Reglas minimas para la demo (P4 las sube en Firebase Console -> Firestore -> Reglas).
// Lectura publica; cada quien solo edita lo suyo. En produccion se exige request.auth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{coleccion}/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if resource.data.autorId == request.resource.data.autorId;
    }
  }
}
